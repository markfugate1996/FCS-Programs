+    w_var.trace_add("write", _update_mm)
+    h_var.trace_add("write", _update_mm)
+    tight_var.trace_add("write", _update_saved)
+
+    btn_row = tk.Frame(sz)
+    btn_row.pack(fill="x", pady=(6, 2))
+    tk.Button(btn_row, text="Apply size", command=_apply_size,
+              width=12, pady=3).pack(side="left", padx=(0, 6))
+    tk.Button(btn_row, text="Refresh", command=lambda: _sync(),
+              width=8, pady=3).pack(side="left")
+    tk.Label(sz, text="      Return in either box also applies",
+             font=("Helvetica", 8), fg="grey").pack(fill="x")
+
+    w_entry.bind("<Return>", _apply_size)
+    h_entry.bind("<Return>", _apply_size)
+
+    _sync()
+    return tight_var
+
