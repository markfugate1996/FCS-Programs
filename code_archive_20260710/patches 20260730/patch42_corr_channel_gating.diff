+# Which detector channels each correlation type requires.  Single-channel
+# acquisitions can only run the autocorrelation of the channel they recorded;
+# the dialog uses this to disable the other options and the compute paths use
+# it to gate (see require_channels).
+_CORR_NEEDS = {
+    "auto_ch1": (1,),
+    "auto_ch2": (2,),
+    "cross":    (1, 2),
+}
+_CORR_FEATURE = {
+    "auto_ch1": "Autocorrelation of Ch1",
+    "auto_ch2": "Autocorrelation of Ch2",
+    "cross":    "Cross-correlation",
+}
+
+
+def supported_corr_types(fcs_data) -> tuple:
+    """
+    The correlation types *fcs_data* can actually support, in dialog order.
+
+    Driven by which channels the file RECORDED, not by how many photons they
+    hold: a dual-channel file with a silent detector still supports every
+    type, and the resulting flat G(tau) is the user's evidence that the
+    detector was silent.
+    """
+    available = tuple(getattr(fcs_data, "channels", (1, 2)))
+    return tuple(v for v in ("cross", "auto_ch1", "auto_ch2")
+                 if all(c in available for c in _CORR_NEEDS[v]))
