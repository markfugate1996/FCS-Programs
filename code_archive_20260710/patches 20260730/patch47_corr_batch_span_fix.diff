+def require_usable_channels(fcs_data, corr_type: str) -> None:
+    """
+    Raise a descriptive ValueError unless *fcs_data* can support *corr_type*.
+
+    Two separate failures, deliberately reported differently:
+
+    * the channel was never RECORDED -- a single-channel file.  Handled by
+      require_channels; the fix is to choose a different correlation type.
+    * the channel was recorded but holds NO PHOTONS -- a dead detector, a
+      shutter left closed, an empty sample.  The file is perfectly valid and
+      loads normally by design, but correlating against it produces
+      "index 0 is out of bounds for axis 0 with size 0" from deep inside the
+      estimator, which tells the user nothing about what went wrong.
+    """
+    needs = _CORR_NEEDS.get(corr_type, ())
+    require_channels(fcs_data, needs,
+                     _CORR_FEATURE.get(corr_type, "This correlation"))
+
+    def _n(ch):
+        getter = getattr(fcs_data, "deltas", None)
+        arr = getter(ch) if getter else (fcs_data.ch1_deltas if ch == 1
+                                         else fcs_data.ch2_deltas)
+        return len(arr)
+
+    empty = [c for c in needs if _n(c) == 0]
+    if empty:
+        name = getattr(getattr(fcs_data, "filepath", None), "name",
+                       "This dataset")
+        which = " and ".join(f"Ch{c}" for c in empty)
+        raise ValueError(
+            f"{_CORR_FEATURE.get(corr_type, 'This correlation')} needs photons "
+            f"on {which}, but {name} recorded none on "
+            f"{'that channel' if len(empty) == 1 else 'those channels'}.\n\n"
+            f"The channel is present in the file but empty -- a detector that "
+            f"saw no light, rather than a channel that was never recorded."
+        )
+
+
