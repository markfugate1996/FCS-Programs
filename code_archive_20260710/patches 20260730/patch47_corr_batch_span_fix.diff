+def _photon_span_s(*time_arrays) -> float:
+    """
+    Wall-clock span (s) covered by the photons actually correlated.
+
+    This is the T that pairs with the photon counts in _cps_meta, so it must be
+    measured the same way the correlator measures it: first to last arrival
+    across the channels that HAVE arrivals.  Empty channels are skipped rather
+    than indexed -- a single-channel file has one empty array, and so does a
+    dual-channel file whose second detector was dead or whose microtime gate
+    excluded every photon on it.
+
+    Returns 0.0 when nothing was correlated at all, which _cps_meta already
+    treats as "cannot be trusted" and drops.
+
+    The single-file and batch paths previously each computed this inline and
+    had drifted apart: the single-file version skipped empty channels, the
+    batch version indexed [-1] unconditionally and raised IndexError.  Both now
+    call this, so they cannot diverge again.
+    """
+    starts = [t[0]  for t in time_arrays if len(t)]
+    stops  = [t[-1] for t in time_arrays if len(t)]
+    return float(max(stops) - min(starts)) if starts else 0.0
+
+
