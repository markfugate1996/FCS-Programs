 # ── Helpers ───────────────────────────────────────────────────────────────────
+
+def _resolve_channels(d, channels) -> tuple[int, ...]:
+    """
+    Turn a caller's *channels* argument into the channels to actually draw.
+
+    ``None`` means "whatever this file recorded", which is what every caller
+    in the suite wants: a single-channel file plots its one decay, a
+    dual-channel file plots both, and nobody has to ask first.  This is the
+    default precisely because it is not a fallback -- it is the correct answer
+    for the file in hand.
+
+    An EXPLICIT request is different and is checked, not quietly trimmed.
+    Asking for Ch2 on a Ch1-only file is a mistake worth hearing about; if it
+    were silently dropped the plot would come back empty with no explanation,
+    or -- worse, in the fitting path -- a decay would be fitted to a histogram
+    that contains nothing.
+    """
+    available = tuple(getattr(d, "channels", (1, 2)))
+    if channels is None:
+        return available
+    channels = tuple(channels)
+    if not channels or not all(c in (1, 2) for c in channels):
+        raise ValueError(
+            "channels must be None, or a non-empty tuple containing 1, 2, "
+            "or both.")
+    require_channels(d, channels, "This lifetime plot")
+    return channels
+
+
+def _lifetime_export_columns(d, n_bins: int, channels: tuple[int, ...]):
+    """
+    Build the (time_ns, columns) pair for a lifetime CSV export.
+
+    The schema is FIXED: ``time_ns``, ``ch1_counts``, ``ch2_counts``, always,
+    in that order, whatever the file recorded and whatever was plotted.  A
+    channel with no data gets a column of NaN rather than being dropped, so
+    every lifetime export -- single-channel, dual-channel, one channel of two
+    plotted -- has the same header and can be read by the same code without
+    inspecting it first.
+
+    NaN is the right filler rather than 0: fcs_export.read_export already maps
+    an empty CSV cell to NaN, so NaN is exactly the value a blank cell reads
+    back as, and it round-trips.  A 0 would read back as a real measurement of
+    no photons.  (fcs_export.export_columns currently renders NaN as the text
+    "nan"; the ``channels`` and ``channels_recorded`` metadata keys say which
+    columns are meaningful either way.)
+    """
+    time_ns  = None
+    counts_by_ch: dict[int, np.ndarray] = {}
+    for ch in channels:
+        bin_times_ns, counts = d.lifetime_histogram(channel=ch, n_bins=n_bins)
+        if time_ns is None:
+            time_ns = bin_times_ns
+        counts_by_ch[ch] = counts
+
+    if time_ns is None:
+        return None, {}
+
+    blank   = np.full(len(time_ns), np.nan, dtype=np.float64)
+    columns = {
+        f"ch{ch}_counts": (counts_by_ch[ch].astype(np.float64)
+                           if ch in counts_by_ch else blank.copy())
+        for ch in (1, 2)
+    }
+    return time_ns, columns
+
+
+def _lifetime_export_meta(d, n_bins: int, channels: tuple[int, ...]) -> dict:
+    """Metadata block shared by the single-file and overlay export paths."""
+    return {
+        "n_bins":            n_bins,
+        "bin_width_ps":      f"{d.laser_period_ns / n_bins * 1000:.4f}",
+        "laser_period_ns":   f"{d.laser_period_ns:.4f}",
+        # What was drawn ...
+        "channels":          "+".join(f"Ch{c}" for c in channels),
+        # ... versus what the file has.  A blank ch2_counts means "not
+        # plotted" when Ch2 appears here and "never recorded" when it does not.
+        "channels_recorded": "+".join(
+            f"Ch{c}" for c in getattr(d, "channels", (1, 2))),
+    }
+
