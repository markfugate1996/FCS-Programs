+def _meta_float(meta: dict, key: str):
+    """Read one numeric header field, or None if absent/unparseable."""
+    v = meta.get(key)
+    if v is None:
+        return None
+    try:
+        return float(str(v).strip())
+    except (TypeError, ValueError):
+        return None
