+#: Models that tie a triplet lifetime to a diffusion time rather than fitting
+#: it directly: (alpha, tau_D, derived name).  The augmented models fit the
+#: RATIO alpha = tau_T/tau_D -- which is the point of them, since alpha can be
+#: held across a series where tau_D moves -- so the lifetime itself has to be
+#: multiplied back out.  It is reported under the name the non-augmented
+#: triplet models FIT, tau_T, so that the two models' tables line up column
+#: for column with nothing to map between them -- which is the whole reason
+#: for deriving it.  Both are listed for the two-component augmented model,
+#: where each species carries its own alpha and its own diffusion time.
+_TRIPLET_TIE = (
+    ("alpha",  "tau_D",  "tau_T"),
+    ("alpha1", "tau_D1", "tau_T1"),
+    ("alpha2", "tau_D2", "tau_T2"),
+)
+
+
+def _triplet_tie_pairs(result: dict) -> list:
+    """
+    The (alpha, tau_D, name) triples this model actually carries.
+
+    A pair is skipped when the model already FITS a parameter of that name.
+    Sharing tau_T with the plain triplet models is deliberate, but a model
+    fitting both alpha and tau_T directly would otherwise produce two columns
+    called tau_T -- one fitted, one derived -- and the second would quietly
+    win in any reader that builds a dict from the header row.  No model in
+    the registry does that today; this keeps it from becoming a puzzle if one
+    ever does.
+    """
+    names = result.get("names") or []
+    return [t for t in _TRIPLET_TIE
+            if t[0] in names and t[1] in names and t[2] not in names]
+
+
