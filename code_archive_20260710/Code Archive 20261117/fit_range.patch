+                  f"{kept} of {total} lag channels  ·  {tail}"),
+            fg="grey" if kept >= 2 else "#a04000")
+
+    rmin_var.trace_add("write", _update_range_note)
+    rmax_var.trace_add("write", _update_range_note)
+    _update_range_note()
