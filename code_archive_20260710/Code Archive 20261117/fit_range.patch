+    def _read_range_ms():
+        """(lo, hi) in ms; None for an open end.  Raises ValueError on junk."""
+        out = []
+        for var, label in ((rmin_var, "minimum"), (rmax_var, "maximum")):
+            text = var.get().strip()
+            if not text:
+                out.append(None)
+                continue
+            try:
+                value = float(text)
+            except ValueError:
+                raise ValueError(f"Fit range {label} is not a number: "
