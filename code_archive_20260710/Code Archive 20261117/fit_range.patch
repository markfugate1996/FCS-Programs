+            range_note.config(text=f"      {exc}", fg="#a04000")
+            return
+        lo_s = None if lo is None else lo * 1e-3
+        hi_s = None if hi is None else hi * 1e-3
+        kept = total = 0
+        for ds in datasets:
+            tau = np.asarray(ds["tau"], dtype=float)
+            usable = np.isfinite(tau) & (tau > 0)
