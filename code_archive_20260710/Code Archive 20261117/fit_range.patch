+                inside &= tau >= lo_s
+            if hi_s is not None:
+                inside &= tau <= hi_s
+            total += int(np.count_nonzero(usable))
+            kept += int(np.count_nonzero(inside))
+        full = (lo_s is None or lo_s <= _tau_lo_s) and \
