+
+    # ── Selector ─────────────────────────────────────────────────────────────
+    list_row = tk.Frame(tf)
+    list_row.pack(fill="x")
+    lb_sb = tk.Scrollbar(list_row, orient="vertical")
+    lb = tk.Listbox(
